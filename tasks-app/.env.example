# Порт HTTP-сервера
PORT=3000

# PIN-коды для входа (у каждого пользователя свой). Обязательно поменяйте!
ASSISTANT_PIN=1111
BOSS_PIN=2222

# Часовой пояс, в котором живут руководитель и ассистент
APP_TIMEZONE=Asia/Bishkek

# За сколько минут до задачи присылать напоминание
REMINDER_MINUTES=30

# Контакт для Web Push (mailto: или https:)
VAPID_SUBJECT=mailto:admin@example.com

# Необязательно: VAPID-ключи и секрет сессий. Если не заданы —
# генерируются при первом запуске и сохраняются в data/db.json.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# SESSION_SECRET=

# Где хранить данные
# DATA_FILE=./data/db.json
