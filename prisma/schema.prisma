// Реестр строительных работ и контроль себестоимости — схема БД.
//
// Принципы:
//  * Денежные значения — Decimal(18,2), объёмы и цены — Decimal(18,4), проценты — Decimal(9,4).
//    Тип float для денег не используется.
//  * NULL означает «нет данных». Ноль хранится только если он подтверждён.
//  * Исходные данные не перезаписываются: версии смет, история выполнения, журнал аудита.
//  * Каждая сумма имеет источник (документ / импорт / ручной ввод).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Пользователи и доступ ─────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // Системный администратор: управляет пользователями, ролями и всеми проектами.
  isAdmin      Boolean   @default(false)
  // Отзыв доступа сотрудника: false — вход запрещён, сессии удаляются.
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions       Session[]
  memberships    ProjectMember[]
  auditLogs      AuditLog[]
  progressRecords WorkProgressRecord[]
  documents      Document[]
  importJobs     ImportJob[]
  recognitions   ActRecognition[]
  issuesAssigned Issue[]         @relation("IssueAssignee")
  issueEvents    IssueEvent[]
}

model Session {
  id        String   @id @default(cuid())
  // В БД хранится только SHA-256 от токена; сам токен — в httpOnly cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Роль — набор прав. Права настраиваемые (администратор может менять список).
model Role {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  permissions String[]
  isSystem    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
}

// Доступ выдаётся на конкретный проект. Доступ к одному проекту не даёт доступа к другим.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  roleId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

// ───────────────────────────── Проектная структура ─────────────────────────────

model Project {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  address     String?
  // Базовая валюта проекта (ISO 4217). KGS — кыргызский сом.
  currency    String   @default("KGS")
  // Демонстрационный проект: данные тестовые, не являются реальными показателями.
  isDemo      Boolean  @default(false)
  isArchived  Boolean  @default(false)
  // Подтверждена ли методика учёта фактической себестоимости по данным 1С (п. 5.5 ТЗ).
  costMethodologyConfirmed Boolean @default(false)
  costMethodologyNote      String?
  // Подтверждена ли модель прогноза «факт + прогноз остатка» (п. 5.7 ТЗ).
  forecastModelConfirmed   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members          ProjectMember[]
  objects          ConstructionObject[]
  stages           ConstructionStage[]
  estimateVersions EstimateVersion[]
  sections         EstimateSection[]
  workItems        WorkItem[]
  contracts        Contract[]
  acts             Act[]
  accountingImports AccountingImport[]
  transactions     AccountingTransaction[]
  payments         Payment[]
  documents        Document[]
  importJobs       ImportJob[]
  auditLogs        AuditLog[]
  recognitions     ActRecognition[]
  classificationRules ClassificationRule[]
  issues           Issue[]
}

// Корпус / объект строительства
model ConstructionObject {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  stages    ConstructionStage[]
  workItems WorkItem[]

  @@unique([projectId, code])
}

// Этап строительства (может относиться ко всему проекту или к корпусу)
model ConstructionStage {
  id           String              @id @default(cuid())
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objectId     String?
  object       ConstructionObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  code         String
  name         String
  sortOrder    Int                 @default(0)
  plannedStart DateTime?           @db.Date
  plannedEnd   DateTime?           @db.Date
  createdAt    DateTime            @default(now())

  workItems WorkItem[]

  @@unique([projectId, code])
}

// ───────────────────────────── Смета ─────────────────────────────

enum EstimateVersionStatus {
  DRAFT      // загружена, ожидает подтверждения
  ACTIVE     // текущая утверждённая версия
  SUPERSEDED // заменена более новой версией (история)
  REJECTED   // отклонена пользователем
}

model EstimateVersion {
  id            String                @id @default(cuid())
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber Int
  name          String
  status        EstimateVersionStatus @default(DRAFT)
  // Первая утверждённая версия — «первоначальная смета». Флаг не снимается.
  isBaseline    Boolean               @default(false)
  currency      String
  notes         String?
  documentId    String?
  document      Document?             @relation(fields: [documentId], references: [id])
  importJobId   String?               @unique
  importJob     ImportJob?            @relation(fields: [importJobId], references: [id])
  createdById   String?
  createdAt     DateTime              @default(now())
  approvedById  String?
  approvedAt    DateTime?

  lines EstimateLine[]

  @@unique([projectId, versionNumber])
}

// Раздел сметы (на уровне проекта, стабилен между версиями)
model EstimateSection {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code      String
  name      String
  sortOrder Int        @default(0)
  workItems WorkItem[]
  lines     EstimateLine[]

  @@unique([projectId, code])
}

enum WorkItemOrigin {
  ESTIMATE // создана из утверждённой сметы
  MANUAL   // добавлена уполномоченным пользователем
}

enum MeasurementType {
  QUANTITY // выполнение измеряется объёмом
  PERCENT  // выполнение вводится процентом готовности
}

// Статья работ — центральная сущность реестра. Стабильный идентификатор,
// по которому связываются договоры, АВР, факт и операции 1С.
// Плановые значения хранятся по версиям смет в EstimateLine.
model WorkItem {
  id              String              @id @default(cuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Ключ сопоставления строк смет между версиями (корпус|раздел|код|...)
  itemKey         String
  code            String?
  name            String
  unit            String?
  objectId        String?
  object          ConstructionObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  stageId         String?
  stage           ConstructionStage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  sectionId       String?
  section         EstimateSection?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  origin          WorkItemOrigin      @default(ESTIMATE)
  measurementType MeasurementType     @default(QUANTITY)
  plannedStartDate DateTime?          @db.Date
  plannedEndDate  DateTime?           @db.Date
  actualEndDate   DateTime?           @db.Date
  comment         String?
  // Прогноз затрат на оставшиеся работы (ручной ввод), для п. 5.7
  forecastRemainingCost Decimal?      @db.Decimal(18, 2)
  forecastNote    String?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  estimateLines   EstimateLine[]
  progressRecords WorkProgressRecord[]
  allocations     ContractWorkAllocation[]
  actLineAllocations ActLineAllocation[]
  transactionAllocations TransactionAllocation[]
  issues          Issue[]
  classificationRules ClassificationRule[]

  @@unique([projectId, itemKey])
  @@index([projectId])
  @@index([projectId, objectId])
  @@index([projectId, stageId])
  @@index([projectId, sectionId])
}

// Строка версии сметы: исходные плановые значения в том виде, как они были в документе.
model EstimateLine {
  id          String           @id @default(cuid())
  versionId   String
  version     EstimateVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  // До утверждения версии строка не связана со статьёй реестра
  workItemId  String?
  workItem    WorkItem?        @relation(fields: [workItemId], references: [id])
  itemKey     String
  lineNo      String?
  code        String?
  name        String
  unit        String?
  sectionId   String?
  section     EstimateSection? @relation(fields: [sectionId], references: [id])
  sectionCode String?
  sectionName String?
  objectCode  String?
  stageCode   String?
  quantity    Decimal?         @db.Decimal(18, 4)
  unitPrice   Decimal?         @db.Decimal(18, 4)
  // Итог из исходной сметы (если был). Используется как исходное значение плановой стоимости.
  sourceTotal Decimal?         @db.Decimal(18, 2)
  currency    String
  // Источник: лист и строка исходного файла
  sourceSheet String?
  sourceRow   Int?
  extra       Json?

  @@unique([versionId, itemKey])
  @@index([workItemId])
}

// ───────────────────────────── Договоры ─────────────────────────────

model Contractor {
  id        String     @id @default(cuid())
  name      String
  // ИНН (в КР — 14 цифр). Уникален, если указан.
  inn       String?    @unique
  comment   String?
  createdAt DateTime   @default(now())
  contracts Contract[]
  acts      Act[]
  payments  Payment[]
  transactionAllocations TransactionAllocation[]
}

// Статус подписания хранится отдельно от статуса действительности
enum ContractSigningStatus {
  UNKNOWN          // не установлен
  NOT_SIGNED       // не подписан
  PARTIALLY_SIGNED // подписан одной стороной
  SIGNED           // подписан сторонами
}

enum ContractStatus {
  UPLOADED_NEEDS_REVIEW // договор загружен, требуется проверка
  ACTIVE                // подписан и действует
  COMPLETED             // завершён
  TERMINATED            // расторгнут
  NEEDS_CLARIFICATION   // требует уточнения
}

model Contract {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractorId String?
  contractor   Contractor?    @relation(fields: [contractorId], references: [id])
  number       String?
  date         DateTime?      @db.Date
  subject      String?
  objectText   String?
  totalAmount  Decimal?       @db.Decimal(18, 2)
  currency     String?
  startDate    DateTime?      @db.Date
  endDate      DateTime?      @db.Date
  paymentTerms String?
  status       ContractStatus @default(UPLOADED_NEEDS_REVIEW)
  signingStatus ContractSigningStatus @default(UNKNOWN)
  contractorInn String?
  // Разрешение распределить на статьи больше текущей суммы договора (исключение с обоснованием)
  overAllocationAllowed Boolean @default(false)
  overAllocationComment String?
  overAllocationById    String?
  // Подтверждение проверки человеком (наличие файла не делает договор действующим)
  verifiedById String?
  verifiedAt   DateTime?
  comment      String?
  documentId   String?
  document     Document?      @relation(fields: [documentId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  amendments  ContractAmendment[]
  allocations ContractWorkAllocation[]
  acts        Act[]
  payments    Payment[]
  transactionAllocations TransactionAllocation[]
  issues      Issue[]
  classificationRules ClassificationRule[]

  @@index([projectId, status])
}

model ContractAmendment {
  id           String    @id @default(cuid())
  contractId   String
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number       String?
  date         DateTime? @db.Date
  description  String?
  // Изменение суммы договора (может быть отрицательным). NULL — сумма не меняется / не распознана.
  amountDelta  Decimal?  @db.Decimal(18, 2)
  newEndDate   DateTime? @db.Date
  isSigned     Boolean   @default(false)
  documentId   String?
  document     Document? @relation(fields: [documentId], references: [id])
  createdAt    DateTime  @default(now())
}

enum AllocationStatus {
  PROPOSED  // предложено (автоматически или вручную), требует проверки
  CONFIRMED // подтверждено пользователем
  REJECTED
}

// Распределение договора по статьям. Один договор — много статей, одна статья — много договоров.
model ContractWorkAllocation {
  id          String           @id @default(cuid())
  contractId  String
  contract    Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  workItemId  String
  workItem    WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  quantity    Decimal?         @db.Decimal(18, 4)
  unit        String?
  unitPrice   Decimal?         @db.Decimal(18, 4)
  amount      Decimal?         @db.Decimal(18, 2)
  status      AllocationStatus @default(PROPOSED)
  source      String?
  confirmedById String?
  confirmedAt DateTime?
  createdAt   DateTime         @default(now())

  @@unique([contractId, workItemId])
  @@index([workItemId])
}

// ───────────────────────────── Физическое выполнение ─────────────────────────────

enum DataSource {
  MANUAL
  EXCEL_IMPORT
  DOCUMENT
  SYSTEM
}

// История выполнения. Записи не удаляются и не изменяются; текущее значение — последняя запись.
model WorkProgressRecord {
  id               String          @id @default(cuid())
  workItemId       String
  workItem         WorkItem        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  // Дата, на которую зафиксировано выполнение
  asOfDate         DateTime        @db.Date
  method           MeasurementType
  // Накопленный фактический подтверждённый объём (для QUANTITY)
  quantity         Decimal?        @db.Decimal(18, 4)
  // Подтверждённый процент готовности (для PERCENT)
  percent          Decimal?        @db.Decimal(9, 4)
  previousQuantity Decimal?        @db.Decimal(18, 4)
  previousPercent  Decimal?        @db.Decimal(9, 4)
  // Превышение планового объёма подтверждено (доп. объёмы / изменение проекта)
  overrunConfirmed Boolean         @default(false)
  comment          String
  source           DataSource      @default(MANUAL)
  documentId       String?
  document         Document?       @relation(fields: [documentId], references: [id])
  importJobId      String?
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([workItemId, createdAt])
}

// ───────────────────────────── АВР ─────────────────────────────

// Юридический статус акта. Не зависит от статуса распознавания.
enum ActStatus {
  DRAFT       // черновик / подготовлен
  ON_APPROVAL // на согласовании
  SIGNED      // подписан (устанавливается только пользователем)
  REJECTED    // отклонён
  CORRECTED   // скорректирован: заменён подписанным корректировочным актом, в расчёт не входит
  ANNULLED    // аннулирован
}

model Act {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId   String?
  contract     Contract?   @relation(fields: [contractId], references: [id])
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id])
  number       String
  date         DateTime    @db.Date
  periodFrom   DateTime?   @db.Date
  periodTo     DateTime?   @db.Date
  status       ActStatus   @default(DRAFT)
  // Корректировочный акт полностью заменяет исходный: после подписания корректировки исходный получает статус CORRECTED
  isCorrection Boolean     @default(false)
  correctsActId String?
  correctsAct  Act?        @relation("ActCorrection", fields: [correctsActId], references: [id])
  corrections  Act[]       @relation("ActCorrection")
  currency     String
  // Реквизиты документа (как в документе)
  customerName   String?
  contractorName String?
  contractorInn  String?
  contractText   String?
  objectText     String?
  // Итог по документу, НДС, сумма прописью — исходные значения документа
  documentTotal  Decimal?  @db.Decimal(18, 2)
  vatAmount      Decimal?  @db.Decimal(18, 2)
  amountInWords  String?
  signatories    String?
  signedAt     DateTime?
  signedById   String?
  annulledAt   DateTime?
  correctedAt  DateTime?
  statusChangedAt DateTime?
  // Подтверждённое исключение при превышении договорных лимитов
  limitOverride        Boolean @default(false)
  limitOverrideComment String?
  limitOverrideById    String?
  // Решение пользователя по вероятному дубликату
  duplicateDecision String?
  comment      String?
  documentId   String?
  document     Document?   @relation(fields: [documentId], references: [id])
  recognition  ActRecognition?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  lines  ActLine[]
  issues Issue[]

  @@index([projectId, status])
  @@index([projectId, number])
}

model ActLine {
  id          String    @id @default(cuid())
  actId       String
  act         Act       @relation(fields: [actId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)
  lineNo      String?
  code        String?
  description String?
  unit        String?
  quantity    Decimal?  @db.Decimal(18, 4)
  unitPrice   Decimal?  @db.Decimal(18, 4)
  amount      Decimal   @db.Decimal(18, 2)
  directCosts Decimal?  @db.Decimal(18, 2)
  note        String?
  pageNumber  Int?
  // Нет соответствия в смете/договоре — требуется решение ответственного
  unmatched   Boolean   @default(false)

  allocations ActLineAllocation[]
}

// Распределение строки акта по статьям: одна строка — несколько статей, одна статья — много актов.
model ActLineAllocation {
  id         String   @id @default(cuid())
  actLineId  String
  actLine    ActLine  @relation(fields: [actLineId], references: [id], onDelete: Cascade)
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  quantity   Decimal? @db.Decimal(18, 4)
  amount     Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  @@unique([actLineId, workItemId])
  @@index([workItemId])
}

enum RecognitionStatus {
  UPLOADED     // загружен
  QUEUED       // ожидает распознавания
  RECOGNIZING  // распознаётся
  NEEDS_REVIEW // требует проверки
  REVIEWED     // проверен пользователем
  CONFIRMED    // подтверждён и сохранён
  FAILED       // ошибка распознавания (оригинал сохранён)
  CANCELLED    // отменён
}

// Черновик распознанного АВР. До подтверждения не влияет на финансовые показатели.
model ActRecognition {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       RecognitionStatus @default(UPLOADED)
  progress     Int               @default(0)
  progressText String?
  error        String?
  ocrProvider  String?
  rawText      String?
  // Реквизиты: { field: { raw, value, confidence, page, bbox, status } }
  fields       Json?
  // Строки таблицы с исходными и нормализованными значениями и предложениями сопоставления
  lines        Json?
  // Результаты арифметических проверок, сопоставления и поиска дубликатов
  checks       Json?
  matches      Json?
  duplicates   Json?
  duplicateDecision String?
  actId        String?           @unique
  act          Act?              @relation(fields: [actId], references: [id])
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id])
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  pages ActRecognitionPage[]

  @@index([projectId, status])
}

model ActRecognitionPage {
  id            String         @id @default(cuid())
  recognitionId String
  recognition   ActRecognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  // Оригинал (неизменяемый) и подготовленное для OCR изображение
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sortOrder     Int
  // Для PDF — номер страницы внутри файла
  sourcePage    Int?
  processedPath String?
  width         Int?
  height        Int?
  rotation      Int?
  meanConfidence Float?
  words         Json?
  error         String?

  @@index([recognitionId])
}

// ───────────────────────────── 1С ─────────────────────────────

enum AccountingImportStatus {
  PREVIEW
  CONFIRMED
  CANCELLED
  FAILED
}

model AccountingImport {
  id          String                 @id @default(cuid())
  projectId   String
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document?              @relation(fields: [documentId], references: [id])
  importJobId String?                @unique
  importJob   ImportJob?             @relation(fields: [importJobId], references: [id])
  account     String?
  periodFrom  DateTime?              @db.Date
  periodTo    DateTime?              @db.Date
  rowCount    Int                    @default(0)
  newRows     Int                    @default(0)
  duplicateRows Int                  @default(0)
  sourceTotal Decimal?               @db.Decimal(18, 2)
  acceptedTotal Decimal?             @db.Decimal(18, 2)
  fileSha256  String?
  status      AccountingImportStatus @default(PREVIEW)
  createdAt   DateTime               @default(now())

  transactions AccountingTransaction[]
}

enum ClassificationStatus {
  UNCLASSIFIED // требует классификации
  PROPOSED     // предварительно классифицировано правилом, требует подтверждения
  CONFIRMED    // классификация подтверждена пользователем
  EXCLUDED     // исключено из расчёта (не относится к объекту и т.п.)
}

// Предварительные категории операций — адаптируются к реальному учёту
enum TransactionCategory {
  UNCLASSIFIED
  COST              // затраты
  ADJUSTMENT        // корректировки
  REVERSAL          // сторно
  INTERNAL_TRANSFER // внутренние перемещения
  SETTLEMENT        // расчёты с контрагентами
  PAYMENT           // платежи
  OTHER             // прочие
}

model AccountingTransaction {
  id            String               @id @default(cuid())
  projectId     String
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  importId      String
  import        AccountingImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber     Int
  // Отпечаток операции для защиты от повторного учёта
  fingerprint   String
  date          DateTime?            @db.Date
  documentNumber String?
  account       String?
  corrAccount   String?
  debit         Decimal?             @db.Decimal(18, 2)
  credit        Decimal?             @db.Decimal(18, 2)
  // Сумма с исходным знаком
  amount        Decimal?             @db.Decimal(18, 2)
  currency      String?
  counterparty  String?
  objectText    String?
  costItemText  String?
  nomenclature  String?
  quantity      Decimal?             @db.Decimal(18, 4)
  comment       String?
  analytics     Json?
  contractText  String?
  raw           Json
  category      TransactionCategory  @default(UNCLASSIFIED)
  classification ClassificationStatus @default(UNCLASSIFIED)
  ruleId        String?
  rule          ClassificationRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  classifiedById String?
  classifiedAt  DateTime?
  exclusionReason String?
  // Возможный дубликат (совпадают документ, дата и сумма, но отличается аналитика) — требует проверки
  possibleDuplicateOfId String?
  createdAt     DateTime             @default(now())

  allocations TransactionAllocation[]
  payments    Payment[]
  issues      Issue[]

  @@unique([projectId, fingerprint])
  @@index([projectId, category, classification])
  @@index([projectId, date])
}

// Правило предварительной классификации операций 1С. Результат правила всегда требует подтверждения.
model ClassificationRule {
  id                  String              @id @default(cuid())
  projectId           String
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  priority            Int                 @default(100)
  isActive            Boolean             @default(true)
  account             String?
  corrAccount         String?
  textContains        String?
  counterpartyContains String?
  category            TransactionCategory
  workItemId          String?
  workItem            WorkItem?           @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  contractId          String?
  contract            Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())

  transactions AccountingTransaction[]
}

model TransactionAllocation {
  id            String                @id @default(cuid())
  transactionId String
  transaction   AccountingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  workItemId    String?
  workItem      WorkItem?             @relation(fields: [workItemId], references: [id])
  contractId    String?
  contract      Contract?             @relation(fields: [contractId], references: [id])
  contractorId  String?
  contractor    Contractor?           @relation(fields: [contractorId], references: [id])
  costType      String?
  amount        Decimal               @db.Decimal(18, 2)
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime              @default(now())

  @@index([transactionId])
  @@index([workItemId])
}

model Payment {
  id            String                 @id @default(cuid())
  projectId     String
  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId    String?
  contract      Contract?              @relation(fields: [contractId], references: [id])
  contractorId  String?
  contractor    Contractor?            @relation(fields: [contractorId], references: [id])
  date          DateTime               @db.Date
  amount        Decimal                @db.Decimal(18, 2)
  currency      String
  documentNumber String?
  source        DataSource             @default(MANUAL)
  transactionId String?                 @unique
  transaction   AccountingTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  comment       String?
  createdAt     DateTime               @default(now())

  @@index([projectId, contractId])
}

// ───────────────────────────── Документы, импорт, аудит ─────────────────────────────

enum DocumentKind {
  ESTIMATE
  CONTRACT
  AMENDMENT
  ACT
  ACCOUNTING
  PROGRESS
  PHOTO
  OTHER
}

// Файл в приватном хранилище. Отдаётся только через маршрут с проверкой прав.
model Document {
  id           String       @id @default(cuid())
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         DocumentKind
  originalName String
  storagePath  String
  mimeType     String
  size         Int
  sha256       String
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  estimateVersions EstimateVersion[]
  contracts        Contract[]
  amendments       ContractAmendment[]
  progressRecords  WorkProgressRecord[]
  acts             Act[]
  accountingImports AccountingImport[]
  importJobs       ImportJob[]
  extractedFields  ExtractedField[]
  recognitionPages ActRecognitionPage[]

  @@index([projectId, sha256])
}

enum ImportKind {
  ESTIMATE
  CONTRACT
  ACT
  ACCOUNTING
  PROGRESS
}

enum ImportJobStatus {
  PARSED    // файл разобран, ждёт сопоставления/подтверждения
  CONFIRMED // данные записаны
  CANCELLED
  FAILED
}

// Журнал обработки файлов: каждая загрузка проходит предпросмотр и подтверждение.
model ImportJob {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        ImportKind
  status      ImportJobStatus @default(PARSED)
  documentId  String?
  document    Document?       @relation(fields: [documentId], references: [id])
  // Выбранное сопоставление столбцов и параметры импорта
  mapping     Json?
  // Сводка результата (кол-во строк, суммы, предупреждения)
  summary     Json?
  error       String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  finishedAt  DateTime?

  estimateVersion  EstimateVersion?
  accountingImport AccountingImport?
}

// Источник извлечённого из документа значения (файл, страница/лист, фрагмент).
model ExtractedField {
  id          String    @id @default(cuid())
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityType  String
  entityId    String
  field       String
  value       String?
  location    String?
  fragment    String?
  needsReview Boolean   @default(true)
  reviewedById String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  comment    String?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
}

// ───────────────────────────── Контроль отклонений ─────────────────────────────

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  NEW             // новая
  ASSIGNED        // назначена
  IN_REVIEW       // на проверке
  NEEDS_DECISION  // требует решения
  RESOLVED        // устранена (условие больше не выполняется)
  CLOSED_EXCEPTION // закрыта с обоснованным исключением
}

// Карточка проблемы. Создаётся проверками автоматически; закрыть можно только устранением причины
// (проверка больше не находит условие) или исключением с обязательным обоснованием.
model Issue {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Уникальный ключ условия, например «WORK_WITHOUT_CONTRACT:<workItemId>»
  key          String
  type         String
  title        String
  severity     IssueSeverity
  status       IssueStatus   @default(NEW)
  workItemId   String?
  workItem     WorkItem?     @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  contractId   String?
  contract     Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  actId        String?
  act          Act?          @relation(fields: [actId], references: [id], onDelete: SetNull)
  transactionId String?
  transaction  AccountingTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  amount       Decimal?      @db.Decimal(18, 2)
  source       String
  details      String?
  assigneeId   String?
  assignee     User?         @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comment      String?
  // Условие обнаруживается последней проверкой
  isActive     Boolean       @default(true)
  detectedAt   DateTime      @default(now())
  lastSeenAt   DateTime      @default(now())
  resolvedAt   DateTime?
  updatedAt    DateTime      @updatedAt

  events IssueEvent[]

  @@unique([projectId, key])
  @@index([projectId, status])
  @@index([projectId, type])
}

model IssueEvent {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  fromStatus IssueStatus?
  toStatus  IssueStatus?
  comment   String?
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}
