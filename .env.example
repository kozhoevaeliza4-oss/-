# Подключение к PostgreSQL. Не храните реальные пароли в репозитории.
DATABASE_URL="postgresql://app:app@localhost:5432/construction_registry?schema=public"
# Каталог приватного файлового хранилища (вне public/). Доступ только через авторизованные маршруты.
STORAGE_DIR="./storage"
# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=25
# Первичный администратор (используется только командой npm run db:seed)
SEED_ADMIN_EMAIL="admin@example.local"
SEED_ADMIN_PASSWORD="change-me-please"
# Cookie сессии только по HTTPS. В продакшене по умолчанию true; false — только для внутренней сети без TLS.
# COOKIE_SECURE=true
# Тестовая БД (имя обязательно оканчивается на _test; таблицы очищаются перед тестами)
# TEST_DATABASE_URL="postgresql://app:app@localhost:5432/construction_registry_test?schema=public"
# Часовой пояс для отображения даты и времени (IANA). По умолчанию Asia/Bishkek.
# APP_TIMEZONE="Asia/Bishkek"
