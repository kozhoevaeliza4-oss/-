# Порт HTTP-сервера
PORT=3000

# Токен для простой авторизации внутренних запросов (Bearer <token>)
API_AUTH_TOKEN=change-me

# --- OCR провайдер ---
# Решение по провайдеру должно быть зафиксировано ДО начала эксплуатации (см. README, п. "Выбор OCR-провайдера").
# Поддерживаемые значения: "yandex" | "mock"
# "mock" используется для локальной разработки и тестов, без реальных запросов наружу.
OCR_PROVIDER=mock

# Ключ Yandex Cloud Vision OCR (никогда не должен попадать в клиентский код/репозиторий)
YANDEX_VISION_API_KEY=
YANDEX_VISION_FOLDER_ID=

# Порог уверенности (0..1), ниже которого поле не подставляется автоматически
OCR_CONFIDENCE_THRESHOLD=0.8

# Через сколько часов удалять исходное фото документа с сервера,
# если оно вообще временно кэшируется (сейчас модуль фото не хранит, см. README, п.7)
ID_PHOTO_RETENTION_HOURS=24

# --- Реестр приказов (регистрация и нумерация) ---
# Порог похожести (0..1) для предупреждения о возможном дублировании приказа
ORDER_DUPLICATE_THRESHOLD=0.7

# Сколько минут хранится неподтверждённый скан приказа до автоочистки
ORDER_SCAN_TTL_MINUTES=60
